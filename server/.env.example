# ── Backend Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your real values

# Server
PORT=5000
NODE_ENV=development

# Client origin (Vite dev server)
CLIENT_ORIGIN=http://localhost:3000

# ── Database ───────────────────────────────────────────────────
# Free MongoDB Atlas cluster: https://www.mongodb.com/cloud/atlas
# Or use MongoDB Compass local: mongodb://127.0.0.1:27017/career_genai
MONGODB_URI=mongodb://127.0.0.1:27017/career_genai

# ── Auth ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string

# ── Google Gemini AI (free tier) ───────────────────────────────
# Get a free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── NVIDIA NIM (free fallback, optional) ───────────────────────
# Get a free API key: https://build.nvidia.com (e.g. meta/llama-3.1-8b-instruct)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── Email (Gmail API — see gmailapi.md) ────────────────────────────
# Set EMAIL_SERVICE=on and fill the OAuth2 credentials below to send
# safety alerts + progress reports to parents through the Gmail REST API:
#   POST https://gmail.googleapis.com/gmail/v1/users/me/messages/send
# Setup:
#   1) Google Cloud Console > create project > enable "Gmail API"
#   2) APIs & Services > OAuth consent screen (External) > add your Gmail as a test user
#   3) APIs & Services > Credentials > Create OAuth 2.0 Client ID
#   4) Exchange the auth code for a refresh token using scope:
#      https://www.googleapis.com/auth/gmail.send
EMAIL_SERVICE=off
GMAIL_USER=your_app_gmail_address@gmail.com
GMAIL_CLIENT_ID=your_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_oauth_refresh_token