# ── Backend Configuration ──────────────────────────────────────
# Copy this file to .env and fill in your real values

# Server
PORT=5000
NODE_ENV=development

# Client origin (Vite dev server)
CLIENT_ORIGIN=http://localhost:3000

# ── Database ───────────────────────────────────────────────────
# Free MongoDB Atlas cluster: https://www.mongodb.com/cloud/atlas
# Or use MongoDB Compass local: mongodb://127.0.0.1:27017/career_genai
MONGODB_URI=mongodb://127.0.0.1:27017/career_genai

# ── Auth ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string

# ── Google Gemini AI (free tier) ───────────────────────────────
# Get a free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── NVIDIA NIM (free fallback, optional) ───────────────────────
# Get a free API key: https://build.nvidia.com (e.g. meta/llama-3.1-8b-instruct)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# ── Email (optional) ───────────────────────────────────────────
# For sending safety alerts to parents via EmailJS (free tier) or Nodemailer
EMAIL_SERVICE=off
EMAIL_FROM=
EMAIL_PASSWORD=